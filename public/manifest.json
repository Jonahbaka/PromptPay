{
  "name": "PromptPay",
  "short_name": "PromptPay",
  "description": "PromptPay gives users a fast mobile app for wallet balance, airtime, data, and transactions while operators run payment networks on licensed rails.",
  "start_url": "/app",
  "id": "/app",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#07111a",
  "theme_color": "#09121b",
  "scope": "/",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open App",
      "short_name": "App",
      "url": "/app"
    },
    {
      "name": "Partner Portal",
      "short_name": "Partner",
      "url": "/secure/partners"
    },
    {
      "name": "Admin Portal",
      "short_name": "Admin",
      "url": "/secure/admin"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
